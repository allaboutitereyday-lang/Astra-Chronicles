# ==========================================
# Astra Chronicles - Environment Configuration
# ==========================================

# OpenRouter API Key for Cloud LLM Models (Sao10K Euryale 70B, DeepSeek V3, etc.)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# (Optional) Nano Banana / Image Synthesis API Key
# BANANA_API_KEY=your_banana_api_key_here

# (Optional) Custom allowed users in JSON format (overrides data/allowed_users.json)
# ALLOWED_USERS={"TESTER-KEY":{"name":"Tester","maxTurns":50,"role":"tester"}}
