# ==========================================
# Astra Chronicles - Environment Configuration
# ==========================================

# OpenRouter API Key for Cloud LLM Models (Sao10K Euryale 70B, DeepSeek V3, etc.)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# (Optional) Nano Banana / Image Synthesis API Key
# BANANA_API_KEY=your_banana_api_key_here

# (Optional) Custom allowed users in JSON format (overrides data/allowed_users.json)
# ALLOWED_USERS={"TESTER-KEY":{"name":"Tester","maxTurns":50,"role":"tester"}}

# (Optional) Supabase Cross-Save Cloud Sync & Auth (Email, Google, Discord, GitHub OAuth)
# Run supabase/schema.sql in your Supabase SQL Editor to initialize the user_progression_bundles table.
# Without these keys, Cross-Save automatically falls back to the built-in Local Realm Server API (/api/cloud-sync) & .astra Portable Files.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here


